---
import { getCollection } from 'astro:content';
import SectionLayout from '@layouts/SectionLayout.astro';

const allProjects = await getCollection('projects', ({ data }) =>
  data.domain === 'research' && !data.draft
);
allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = allProjects
  .filter((p) => p.data.featured)
  .map((p) => ({ data: p.data, slug: p.id }));

const secondary = allProjects
  .filter((p) => !p.data.featured)
  .map((p) => ({ data: p.data, slug: p.id }));
---

<SectionLayout
  title="Research"
  description="Academic research in affect-mediated computing and human-robot interaction."
  sectionId="research"
>
  <div class="exhibition">

    <!-- ── Masthead ───────────────────────────────────────── -->
    <header class="masthead">
      <div class="masthead-top">
        <span class="masthead-section">SCIENCE BAY · RESEARCH</span>
      </div>
      <div class="masthead-locator">
        <div class="loc-line"></div>
        <span class="loc-text">⬡ X: 108.7  Y: 028.5  [VP-01 // SCIENCE BAY]</span>
        <div class="loc-line"></div>
      </div>
      <h1 class="masthead-title">Selected Works</h1>
      <p class="masthead-sub">Academic research by Vivek Pai</p>
      <div class="masthead-rule"></div>
    </header>

    <!-- ── Publications ───────────────────────────────────── -->
    {featured.map(({ data, slug }) => (
      <article class="work">

        <div class="work-reticle" aria-hidden="true"></div>

        <div class="pub-badge">↗ Published Paper</div>

        <div class="work-meta-row">
          {data.subtitle && <span class="work-venue">{data.subtitle}</span>}
          <time class="work-year" datetime={data.date.toISOString()}>
            {data.date.getFullYear()}
          </time>
        </div>

        <h2 class="work-title">{data.title}</h2>

        <p class="work-pullquote">{data.caption}</p>

        <footer class="work-footer">
          {data.tags.length > 0 && (
            <div class="work-tags">
              {data.tags.map((t: string) => <span class="tag">{t}</span>)}
            </div>
          )}
          {data.links && data.links.length > 0 && (
            <div class="work-links">
              {data.links.map((l: { label: string; url: string }) => (
                <a href={l.url} class="work-link" target="_blank" rel="noopener noreferrer">
                  ↗ {l.label}
                </a>
              ))}
            </div>
          )}
        </footer>

        <a href={`/projects/${slug}`} class="work-cover" aria-label={`View ${data.title}`}></a>

      </article>
    ))}

    <!-- ── Earlier Work ───────────────────────────────────── -->
    {secondary.length > 0 && (
      <>
        <div class="section-sep">
          <div class="sep-line"></div>
          <span class="sep-label">Earlier Work</span>
          <div class="sep-line"></div>
        </div>

        <div class="secondary-list">
          {secondary.map(({ data, slug }) => (
            <article class="secondary-work">
              <div class="work-reticle" aria-hidden="true"></div>
              <div class="secondary-meta">
                {data.subtitle && <span class="secondary-venue">{data.subtitle}</span>}
                <time class="work-year" datetime={data.date.toISOString()}>
                  {data.date.getFullYear()}
                </time>
              </div>
              <h3 class="secondary-title">{data.title}</h3>
              <p class="secondary-caption">{data.caption}</p>
              <a href={`/projects/${slug}`} class="work-cover" aria-label={`View ${data.title}`}></a>
            </article>
          ))}
        </div>
      </>
    )}

  </div>
</SectionLayout>

<style>
  .exhibition {
    max-width: 72ch;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 3rem 6rem;
  }

  /* ── Masthead ─────────────────────────────────────────── */

  .masthead {
    margin-bottom: 5rem;
  }

  .masthead-top {
    margin-bottom: 1.25rem;
  }

  .masthead-section {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-line);
  }

  .masthead-locator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .loc-line {
    flex: 1;
    border-top: 1px dashed var(--color-line);
    opacity: 0.3;
  }

  .loc-text {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--color-line);
    opacity: 0.55;
    white-space: nowrap;
  }

  .masthead-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    color: #1a1a1a;
    margin: 0 0 0.6rem;
  }

  .masthead-sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-line);
    margin: 0 0 1.5rem;
  }

  .masthead-rule {
    height: 3px;
    background: #1a1a1a;
  }

  /* ── Featured publications ────────────────────────────── */

  .work {
    position: relative;
    padding-block: 3.5rem;
    padding-inline: 1.25rem;
    border-bottom: 1px solid var(--color-line-dim);
    cursor: pointer;
  }

  .work:last-of-type {
    border-bottom: none;
  }

  /* Cover link is last in DOM — sits above non-positioned content naturally */
  .work-cover {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Paper links must be above the cover link */
  .work-links {
    position: relative;
    z-index: 2;
  }

  /* Published badge */
  .pub-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(218, 79, 46, 0.08);
    border: 1px solid var(--color-accent);
    padding: 0.25em 0.6em;
    border-radius: 2px;
    margin-bottom: 1.25rem;
  }

  .work,
  .secondary-work {
    transition: box-shadow 180ms ease, background 180ms ease;
  }

  .work:hover,
  .secondary-work:hover {
    background: rgba(218, 79, 46, 0.04);
    box-shadow: inset 2px 0 0 rgba(218, 79, 46, 0.35);
  }

  .work-reticle {
    position: absolute;
    inset: 10px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
    background:
      linear-gradient(to right,  var(--color-accent) 26px, transparent 26px) top    left  / 26px 2px no-repeat,
      linear-gradient(to bottom, var(--color-accent) 26px, transparent 26px) top    left  / 2px 26px no-repeat,
      linear-gradient(to left,   var(--color-accent) 26px, transparent 26px) bottom right / 26px 2px no-repeat,
      linear-gradient(to top,    var(--color-accent) 26px, transparent 26px) bottom right / 2px 26px no-repeat;
  }

  .work:hover .work-reticle,
  .secondary-work:hover .work-reticle { opacity: 1; }


  .work-footer {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
  }

  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-left: auto;
  }

  .work-link {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 120ms ease;
  }

  .work-link:hover { opacity: 0.65; }

  .work-meta-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .work-venue {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 0.15em 0.5em;
    border: 1px solid var(--color-accent);
    border-radius: 2px;
  }

  .work-year {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--color-line);
  }

  .work-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.15;
    color: #1a1a1a;
    margin: 0 0 1.25rem;
    transition: color 150ms ease;
  }

  .work-pullquote {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.05rem, 2.5vw, 1.3rem);
    line-height: 1.6;
    color: var(--color-line);
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent);
  }

  .work-tags {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-heading);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-line);
    padding: 0.2em 0.55em;
    border: 1px solid var(--color-line-faint);
    border-radius: 2px;
  }

  /* ── Section separator ────────────────────────────────── */

  .section-sep {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block: 3rem 2rem;
  }

  .sep-line {
    flex: 1;
    border-top: 1px dashed var(--color-line);
    opacity: 0.25;
  }

  .sep-label {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-line);
    opacity: 0.5;
    white-space: nowrap;
  }

  /* ── Secondary (earlier work) ─────────────────────────── */

  .secondary-list {
    display: flex;
    flex-direction: column;
  }

  .secondary-work {
    position: relative;
    padding-block: 1.5rem;
    padding-inline: 1.25rem;
    border-bottom: 1px solid var(--color-line-faint);
    cursor: pointer;
  }


  .secondary-work:last-child {
    border-bottom: none;
  }

  .secondary-meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .secondary-venue {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-line);
    opacity: 0.6;
  }

  .secondary-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: #3a3a3a;
    margin: 0 0 0.35rem;
    transition: color 150ms ease;
  }

  .secondary-caption {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-line);
    margin: 0;
    line-height: 1.5;
  }
</style>
