---
import { getCollection, render } from 'astro:content';
import SectionLayout from '@layouts/SectionLayout.astro';

const allProjects = await getCollection('projects', ({ data }) =>
  data.domain === 'research' && !data.draft
);
allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const works = await Promise.all(
  allProjects.map(async (p) => {
    const { Content } = await render(p);
    return { data: p.data, slug: p.id, Content };
  })
);

const yearRange = works.length
  ? `${works[works.length - 1].data.date.getFullYear()}–${works[0].data.date.getFullYear()}`
  : '';
---

<SectionLayout
  title="Research"
  description="Academic research in affect-mediated computing and human-robot interaction."
  sectionId="research"
>
  <div class="exhibition">

    <!-- ── Masthead ───────────────────────────────────────── -->
    <header class="masthead">
      <div class="masthead-top">
        <span class="masthead-section">SCIENCE BAY · RESEARCH</span>
        <span class="masthead-range">{yearRange}</span>
      </div>
      <div class="masthead-locator">
        <div class="loc-line"></div>
        <span class="loc-text">⬡ X: 108.7  Y: 028.5  [VP-01 // SCIENCE BAY]</span>
        <div class="loc-line"></div>
      </div>
      <h1 class="masthead-title">Selected Works</h1>
      <p class="masthead-sub">Academic research by Vivek Pai</p>
      <div class="masthead-rule"></div>
    </header>

    <!-- ── Works ──────────────────────────────────────────── -->
    {works.map(({ data, Content }) => (
      <article class="work">

        <div class="work-meta-row">
          {data.subtitle && <span class="work-venue">{data.subtitle}</span>}
          <time class="work-year" datetime={data.date.toISOString()}>
            {data.date.getFullYear()}
          </time>
        </div>

        <h2 class="work-title">{data.title}</h2>

        <!-- Accessible pullquote — the "so what" for non-academics -->
        <p class="work-pullquote">{data.caption}</p>

        <div class="work-divider"></div>

        <div class="work-body">
          <Content />
        </div>

        <footer class="work-footer">
          {data.tags.length > 0 && (
            <div class="work-tags">
              {data.tags.map((t: string) => <span class="tag">{t}</span>)}
            </div>
          )}
          {data.links && data.links.length > 0 && (
            <div class="work-links">
              {data.links.map((l: { label: string; url: string }) => (
                <a href={l.url} class="work-link" target="_blank" rel="noopener noreferrer">
                  ↗ {l.label}
                </a>
              ))}
            </div>
          )}
        </footer>

      </article>
    ))}

  </div>
</SectionLayout>

<style>
  .exhibition {
    max-width: 72ch;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 3rem 6rem;
  }

  /* ── Masthead ─────────────────────────────────────────── */

  .masthead {
    margin-bottom: 5rem;
  }

  .masthead-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .masthead-section,
  .masthead-range {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-line);
  }

  .masthead-locator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .loc-line {
    flex: 1;
    border-top: 1px dashed var(--color-line);
    opacity: 0.3;
  }

  .loc-text {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--color-line);
    opacity: 0.55;
    white-space: nowrap;
  }

  .masthead-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    color: #1a1a1a;
    margin: 0 0 0.6rem;
  }

  .masthead-sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-line);
    margin: 0 0 1.5rem;
  }

  .masthead-rule {
    height: 3px;
    background: #1a1a1a;
  }

  /* ── Work entries ─────────────────────────────────────── */

  .work {
    padding-block: 3.5rem;
    border-bottom: 1px solid var(--color-line-dim);
  }

  .work:last-child {
    border-bottom: none;
  }

  .work-meta-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .work-venue {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 0.15em 0.5em;
    border: 1px solid var(--color-accent);
    border-radius: 2px;
  }

  .work-year {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--color-line);
  }

  .work-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.15;
    color: #1a1a1a;
    margin: 0 0 1.25rem;
  }

  /* The "so what" — large italic, accessible to non-academics */
  .work-pullquote {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.05rem, 2.5vw, 1.3rem);
    line-height: 1.6;
    color: var(--color-line);
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent);
  }

  .work-divider {
    height: 1px;
    background: var(--color-line-dim);
    margin-block: 1.75rem;
  }

  .work-body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.8;
    color: #2a2a2a;
  }

  .work-body :global(p) { margin: 0 0 1em; }
  .work-body :global(p:last-child) { margin-bottom: 0; }

  /* ── Work footer ──────────────────────────────────────── */

  .work-footer {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-heading);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-line);
    padding: 0.2em 0.55em;
    border: 1px solid var(--color-line-faint);
    border-radius: 2px;
  }

  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .work-link {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 120ms ease;
  }

  .work-link:hover { opacity: 0.7; }
</style>
