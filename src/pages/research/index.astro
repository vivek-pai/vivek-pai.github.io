---
import { getCollection } from 'astro:content';
import SectionLayout from '@layouts/SectionLayout.astro';

const allProjects = await getCollection('projects', ({ data }) =>
  data.domain === 'research' && !data.draft
);
const featured = allProjects.filter((p) => p.data.featured);
const rest = allProjects.filter((p) => !p.data.featured);
---

<SectionLayout
  title="Research"
  description="Academic research in HCI, affect-mediated computing, and human-robot interaction."
  sectionId="research"
>
  <vp-section-hero
    title="Research"
    description="Academic work spanning affect-sensing, human-robot interaction, and rapport detection — from CMU's ArticuLab to the FLAIRS conference."
   
  ></vp-section-hero>

  <div class="container">
    {featured.length > 0 && (
      <section class="project-section">
        <vp-annotation-label text="Featured" show-line></vp-annotation-label>
        <vp-project-grid variant="featured">
          {featured.map((p) => (
            <vp-project-card
              title={p.data.title}
              subtitle={p.data.subtitle ?? ''}
              caption={p.data.caption}
              hero-image={p.data.heroImage ?? ''}
              hero-image-alt={p.data.heroImageAlt}
              tags={p.data.tags.join(',')}
              date={p.data.date.toISOString()}
              featured
             
            ></vp-project-card>
          ))}
        </vp-project-grid>
      </section>
    )}

    {rest.length > 0 && (
      <section class="project-section">
        <vp-annotation-label text="Papers & Studies" show-line></vp-annotation-label>
        <vp-project-grid variant="standard">
          {rest.map((p) => (
            <vp-project-card
              title={p.data.title}
              subtitle={p.data.subtitle ?? ''}
              caption={p.data.caption}
              tags={p.data.tags.join(',')}
              date={p.data.date.toISOString()}
             
            ></vp-project-card>
          ))}
        </vp-project-grid>
      </section>
    )}
  </div>
</SectionLayout>

<style>
  .project-section {
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
