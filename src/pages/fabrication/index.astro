---
import { getCollection } from 'astro:content';
import SectionLayout from '@layouts/SectionLayout.astro';

const allProjects = await getCollection('projects', ({ data }) =>
  data.domain === 'fabrication' && !data.draft
);
allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recordCount = String(allProjects.length).padStart(2, '0');
---

<SectionLayout
  title="Fabrication"
  description="Physical making — 3D printing, laser cutting, and electronic prototyping."
  sectionId="fabrication"
>
  <div class="terminal">

    <!-- ── Header ───────────────────────────────────────── -->
    <header class="term-header">
      <div class="term-eyebrow">ENGINEERING DECK · FABRICATION</div>
      <div class="term-locator">
        <div class="loc-line"></div>
        <span class="loc-text">⬡ X: 094.2  Y: 055.8  [VP-01 // ENG. DECK]</span>
        <div class="loc-line"></div>
      </div>
      <div class="term-prompt">
        <span class="prompt-caret">&gt;</span>
        <span class="prompt-cmd">DIR /WORKSHOP/</span>
        <span class="prompt-result">[{recordCount} RECORDS FOUND]</span>
      </div>
      <div class="term-rule"></div>
    </header>

    <!-- ── Grid ─────────────────────────────────────────── -->
    <div class="dir-grid">
      {allProjects.map((p, i) => (
        <article class="dir-card">

          <div class="card-tab">
            <span class="card-index">
              <span class="card-caret" aria-hidden="true">&gt; </span>
              [{String(i + 1).padStart(2, '0')}]
            </span>
            <time class="card-year" datetime={p.data.date.toISOString()}>
              {p.data.date.getFullYear()}
            </time>
          </div>

          <div class="card-image">
            {p.data.heroImage ? (
              <img src={p.data.heroImage} alt={p.data.heroImageAlt} loading="lazy" />
            ) : (
              <div class="image-placeholder">
                <span class="image-label">// NO PREVIEW</span>
              </div>
            )}
          </div>

          <div class="card-info">
            <h2 class="card-title">{p.data.title}</h2>
            {p.data.subtitle && <p class="card-sub">{p.data.subtitle}</p>}
            <p class="card-caption">{p.data.caption}</p>
          </div>

          <div class="card-tags">
            {p.data.tags.map((t: string) => <span class="card-tag">{t}</span>)}
          </div>

          <a href={`/projects/${p.id}`} class="card-cover" aria-label={`View ${p.data.title}`}></a>

        </article>
      ))}
    </div>

    <!-- ── Footer ───────────────────────────────────────── -->
    <div class="term-footer">
      <div class="term-rule"></div>
      <div class="term-cursor">
        <span class="prompt-caret">&gt;</span>
        <span class="cursor-block" aria-hidden="true">█</span>
      </div>
    </div>

  </div>
</SectionLayout>

<style>
  .terminal {
    padding-inline: 2.5rem;
    padding-block: 3rem 6rem;
  }

  /* ── Header ─────────────────────────────────────────── */

  .term-header {
    margin-bottom: 2.5rem;
  }

  .term-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-line);
    opacity: 0.7;
    margin-bottom: 1.25rem;
  }

  .term-locator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .loc-line {
    flex: 1;
    border-top: 1px dashed var(--color-line);
    opacity: 0.3;
  }

  .loc-text {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--color-line);
    opacity: 0.55;
    white-space: nowrap;
  }

  .term-prompt {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .prompt-caret {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .prompt-cmd {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #1a1a1a;
  }

  .prompt-result {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--color-line);
    opacity: 0.55;
    margin-left: auto;
    white-space: nowrap;
  }

  .term-rule {
    height: 2px;
    background: #1a1a1a;
  }

  /* ── Grid ───────────────────────────────────────────── */

  .dir-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  /* ── Card ───────────────────────────────────────────── */

  .dir-card {
    position: relative;
    border: 1px solid rgba(139, 115, 85, 0.4);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: border-color 180ms ease;
  }

  .dir-card:hover {
    border-color: var(--color-accent);
  }

  /* Cover link — last in DOM, sits above passive content */
  .card-cover {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Color overlay + scan lines — removed on hover to reveal the image */
  .card-image {
    position: relative;
  }

  .card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 2px,
        rgba(0, 0, 0, 0.07) 2px,
        rgba(0, 0, 0, 0.07) 3px
      ),
      rgba(218, 79, 46, 0.45);
    transition: opacity 280ms ease;
    pointer-events: none;
  }

  .dir-card:hover .card-image::after {
    opacity: 0;
  }

  .card-tab {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.85rem;
    background: rgba(139, 115, 85, 0.1);
    border-bottom: 1px solid rgba(139, 115, 85, 0.28);
    flex-shrink: 0;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .dir-card:hover .card-tab {
    background: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .card-caret {
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .dir-card:hover .card-caret {
    opacity: 1;
  }

  .card-index {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    font-weight: 600;
    transition: color 180ms ease;
  }

  .dir-card:hover .card-index {
    color: #F9F8F8;
  }

  .card-year {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--color-line);
    opacity: 0.65;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .dir-card:hover .card-year {
    color: rgba(249, 248, 248, 0.75);
    opacity: 1;
  }

  .card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(139, 115, 85, 0.06);
    border-bottom: 1px dashed rgba(139, 115, 85, 0.28);
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-line);
    opacity: 0.28;
  }

  .card-info {
    padding: 1rem;
    flex: 1;
    border-bottom: 1px dashed rgba(139, 115, 85, 0.2);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.8vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #1a1a1a;
    margin: 0 0 0.2rem;
  }

  .card-sub {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-line);
    opacity: 0.65;
    margin: 0 0 0.75rem;
  }

  .card-caption {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.65;
    color: #3a3a3a;
    margin: 0;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.65rem 1rem;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-line);
    opacity: 0.7;
    padding: 0.18em 0.45em;
    border: 1px solid rgba(139, 115, 85, 0.3);
  }

  /* ── Footer ─────────────────────────────────────────── */

  .term-footer {
    margin-top: 3rem;
  }

  .term-cursor {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .cursor-block {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-accent);
    animation: blink 1.2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── Mobile ─────────────────────────────────────────── */

  @media (max-width: 360px) {
    .terminal {
      padding-inline: 1rem;
    }
  }
</style>
