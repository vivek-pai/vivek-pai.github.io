---
import { getCollection } from 'astro:content';
import SectionLayout from '@layouts/SectionLayout.astro';

const allProjects = await getCollection('projects', ({ data }) =>
  data.domain === 'hci' && !data.draft
);
allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const projects = allProjects.map((p) => ({ data: p.data, slug: p.id }));
const [hero, ...gridProjects] = projects;
---

<SectionLayout
  title="HCI & Work"
  description="Human-computer interaction research, product design, and engineering."
  sectionId="hci"
>
  <div class="magazine">

    <!-- ── Cover ─────────────────────────────────────────── -->
    <header class="cover">
      <div class="cover-top">
        <span class="cover-eyebrow">BRIDGE SECTION · HCI &amp; WORK</span>
        <div class="cover-locator">
          <div class="loc-line"></div>
          <span class="loc-text">⬡ X: 072.4  Y: 031.2  [VP-01 // BRIDGE]</span>
          <div class="loc-line"></div>
        </div>
      </div>
      <div class="cover-title-row">
        <h1 class="cover-title">Design &amp;<br/>HCI</h1>
        <p class="cover-deck">
          The work I keep coming back to — interfaces,
          systems, and the people who use them.
        </p>
      </div>
      <div class="cover-rule"></div>
    </header>

    <!-- ── Hero spread (most recent) ────────────────────── -->
    {hero && (
      <a href={`/projects/${hero.slug}`} class="spread">
        <div class="spread-hero-wrap">
          <div class="spread-hero">
            {hero.data.heroImage ? (
              <img src={hero.data.heroImage} alt={hero.data.heroImageAlt} loading="lazy" />
            ) : (
              <div class="hero-placeholder">
                <span class="hero-n">01</span>
              </div>
            )}
            <div class="hero-overline">
              {hero.data.subtitle && <span class="overline-venue">{hero.data.subtitle}</span>}
              <time class="overline-year" datetime={hero.data.date.toISOString()}>
                {hero.data.date.getFullYear()}
              </time>
            </div>
          </div>
          <div class="hero-reticle" aria-hidden="true"></div>
        </div>
        <h2 class="spread-title">{hero.data.title}</h2>
        <p class="spread-lede">{hero.data.caption}</p>
        <div class="spread-rule"></div>
        {hero.data.tags.length > 0 && (
          <div class="spread-tags">
            {hero.data.tags.map((t: string) => <span class="tag">{t}</span>)}
          </div>
        )}
      </a>
    )}

    <!-- ── Grid (remaining projects) ─────────────────────── -->
    {gridProjects.length > 0 && (
      <div class="projects-grid">
        {gridProjects.map(({ data, slug }) => (
          <a href={`/projects/${slug}`} class="card">
            <div class="card-hero">
              {data.heroImage ? (
                <img src={data.heroImage} alt={data.heroImageAlt} loading="lazy" />
              ) : (
                <div class="card-hero-placeholder"></div>
              )}
              <div class="hero-overline">
                {data.subtitle && <span class="overline-venue">{data.subtitle}</span>}
                <time class="overline-year" datetime={data.date.toISOString()}>
                  {data.date.getFullYear()}
                </time>
              </div>
              <div class="hero-reticle" aria-hidden="true"></div>
            </div>
            <h3 class="card-title">{data.title}</h3>
            <p class="card-lede">{data.caption}</p>
            <div class="spread-rule"></div>
            {data.tags.length > 0 && (
              <div class="spread-tags">
                {data.tags.map((t: string) => <span class="tag">{t}</span>)}
              </div>
            )}
          </a>
        ))}
      </div>
    )}

  </div>
</SectionLayout>

<style>
  .magazine {
    max-width: min(95vw, 900px);
    margin-inline: auto;
    padding-inline: 2rem;
    padding-block: 3rem 6rem;
  }

  /* ── Cover ──────────────────────────────────────────── */

  .cover {
    margin-bottom: 5rem;
  }

  .cover-top {
    margin-bottom: 2.5rem;
  }

  .cover-eyebrow {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-line);
    margin-bottom: 1.25rem;
  }

  .cover-locator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .loc-line {
    flex: 1;
    border-top: 1px dashed var(--color-line);
    opacity: 0.3;
  }

  .loc-text {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--color-line);
    opacity: 0.55;
    white-space: nowrap;
  }

  .cover-title-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .cover-title {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin: 0;
  }

  .cover-deck {
    font-family: var(--font-body);
    font-size: 1rem;
    font-style: italic;
    line-height: 1.65;
    color: var(--color-line);
    margin: 0;
    padding-bottom: 0.4rem;
    max-width: 36ch;
  }

  .cover-rule {
    height: 3px;
    background: #1a1a1a;
  }

  /* ── Spreads ────────────────────────────────────────── */

  .spread {
    display: block;
    padding-block: 5rem;
    border-bottom: 1px solid var(--color-line-dim);
    color: inherit;
    text-decoration: none;
    transition: opacity 120ms ease;
  }

  .spread:last-child {
    border-bottom: none;
  }

  .spread:hover .spread-rule { width: 5rem; }
  .spread:hover .hero-reticle { opacity: 1; }

  .spread-rule {
    transition: width 200ms ease;
  }

  /* Hero image */
  .spread-hero-wrap {
    position: relative;
    margin-bottom: 2rem;
  }

  .spread-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .spread-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 220ms ease;
  }

  .spread:hover .spread-hero img {
    filter: brightness(0.82);
  }

  .hero-reticle {
    position: absolute;
    inset: -8px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
    z-index: 2;
    background:
      linear-gradient(to right,  var(--color-accent) 22px, transparent 22px) top    left  / 22px 2px no-repeat,
      linear-gradient(to bottom, var(--color-accent) 22px, transparent 22px) top    left  / 2px 22px no-repeat,
      linear-gradient(to left,   var(--color-accent) 22px, transparent 22px) top    right / 22px 2px no-repeat,
      linear-gradient(to bottom, var(--color-accent) 22px, transparent 22px) top    right / 2px 22px no-repeat,
      linear-gradient(to right,  var(--color-accent) 22px, transparent 22px) bottom left  / 22px 2px no-repeat,
      linear-gradient(to top,    var(--color-accent) 22px, transparent 22px) bottom left  / 2px 22px no-repeat,
      linear-gradient(to left,   var(--color-accent) 22px, transparent 22px) bottom right / 22px 2px no-repeat,
      linear-gradient(to top,    var(--color-accent) 22px, transparent 22px) bottom right / 2px 22px no-repeat;
  }

  .hero-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: 1.5rem 2rem;
    box-sizing: border-box;
  }

  .hero-n {
    font-family: var(--font-heading);
    font-size: clamp(6rem, 18vw, 12rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-line);
    opacity: 0.08;
    user-select: none;
  }

  /* Overline floats at the bottom of the hero */
  .hero-overline {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background: rgba(249, 248, 248, 0.88);
    backdrop-filter: blur(4px);
    border-top: 1px solid rgba(139, 115, 85, 0.2);
  }

  .overline-venue {
    font-family: var(--font-heading);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 0.1em 0.45em;
    border: 1px solid var(--color-accent);
    border-radius: 2px;
  }

  .overline-year {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--color-line);
    opacity: 0.65;
  }

  /* Display title */
  .spread-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin: 0 0 1.25rem;
  }

  /* Lede — large italic hook */
  .spread-lede {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.15rem, 2.5vw, 1.4rem);
    line-height: 1.6;
    color: #3a3a3a;
    margin: 0 0 2rem;
    max-width: 62ch;
  }

  .spread-rule {
    width: 3rem;
    height: 2px;
    background: var(--color-accent);
    margin-bottom: 2rem;
  }

  .spread-tags {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-line);
    padding: 0.2em 0.55em;
    border: 1px solid var(--color-line-faint);
    border-radius: 2px;
  }

  /* ── Projects grid ──────────────────────────────────── */

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 2.5rem;
    padding-top: 4rem;
    border-top: 1px solid var(--color-line-dim);
  }

  .card {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: opacity 120ms ease;
  }

  .card:hover .spread-rule { width: 5rem; }
  .card:hover .hero-reticle { opacity: 1; }
  .card:hover .card-hero img { filter: brightness(0.82); }
  .card:hover .card-title { color: var(--color-accent); }

  .card-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-alt);
    margin-bottom: 1.25rem;
  }

  .card-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 220ms ease;
  }

  .card-hero-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-bg-alt);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #1a1a1a;
    margin: 0 0 0.75rem;
    transition: color 180ms ease;
  }

  .card-lede {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #3a3a3a;
    margin: 0 0 1.25rem;
  }

  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
