---
import { getCollection } from 'astro:content';
import SectionLayout from '@layouts/SectionLayout.astro';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const sorted = allProjects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<SectionLayout
  title="Archive"
  description="A full directory of projects, old and new."
  sectionId=""
>
  <vp-section-hero
    title="Archive"
    description="Everything — in chronological order."
   
  ></vp-section-hero>

  <div class="container">
    <table class="archive-table">
      <thead>
        <tr>
          <th>Year</th>
          <th>Project</th>
          <th>Domain</th>
          <th>Tags</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map((p) => (
          <tr>
            <td class="year-col">{new Date(p.data.date).getFullYear()}</td>
            <td class="title-col">
              <span class="project-title">{p.data.title}</span>
              {p.data.subtitle && (
                <span class="project-sub">{p.data.subtitle}</span>
              )}
            </td>
            <td class="domain-col">
              <vp-tag-chip label={p.data.domain}></vp-tag-chip>
            </td>
            <td class="tags-col">
              <div class="tag-row">
                {p.data.tags.map((t) => (
                  <vp-tag-chip label={t}></vp-tag-chip>
                ))}
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</SectionLayout>

<style>
  .archive-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-heading);
    font-size: 0.8rem;
  }

  thead th {
    text-align: left;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-line);
    padding: 0 0.75rem 0.75rem 0;
    border-bottom: 1px solid var(--color-line-dim);
  }

  tbody tr {
    border-bottom: 1px solid var(--color-line-dim);
    transition: background-color 120ms ease;
  }

  tbody tr:hover {
    background-color: var(--color-bg-alt);
  }

  td {
    padding: 0.75rem 0.75rem 0.75rem 0;
    vertical-align: top;
  }

  .year-col {
    color: var(--color-text-muted);
    white-space: nowrap;
    width: 4rem;
  }

  .title-col {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }

  .project-title {
    color: var(--color-text);
  }

  .project-sub {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .domain-col {
    white-space: nowrap;
  }

  .tags-col .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
  }

  @media (max-width: 600px) {
    .domain-col,
    .tags-col {
      display: none;
    }
  }
</style>
