---
import SectionLayout from '@layouts/SectionLayout.astro';

const today = new Date();
const logDate = today.toISOString().split('T')[0].replace(/-/g, '.');
---

<SectionLayout
  title="About"
  description="Vivek Pai — HCI practitioner, maker, researcher, and aspiring Starfleet captain."
  sectionId="about"
>
  <div class="log">

    <!-- ── Header ─────────────────────────────────────── -->
    <header class="log-header">
      <div class="log-eyebrow">CAPTAIN'S QUARTERS · ABOUT</div>
      <div class="log-locator">
        <div class="loc-line"></div>
        <span class="loc-text">⬡ X: 078.9  Y: 108.6  [VP-01 // CAPTAIN'S QTR]</span>
        <div class="loc-line"></div>
      </div>
      <div class="log-entry-line">
        <span class="log-label">LOG ENTRY</span>
        <span class="log-date">{logDate}</span>
      </div>
    </header>

    <!-- ── Photo + Bio ───────────────────────────────── -->
    <div class="log-layout">

      <div class="photo-wrap">
        <div class="photo-frame">
          <img
            src="/about/vivek.jpg"
            alt="Vivek Pai"
            class="photo"
          />
        </div>
      </div>

      <div class="log-body">
        <p>
          Still chasing the LCARS computer. The one that listens,
          understands, and gets out of the way.
        </p>
        <p>
          Built things. Studied things. Performed, occasionally.
          Want to do more of the last one.
        </p>
      </div>

    </div>

  </div>
</SectionLayout>

<style>
  .log {
    max-width: 56ch;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 3rem 6rem;
  }

  /* ── Header ─────────────────────────────────────────── */

  .log-header {
    margin-bottom: 3rem;
  }

  .log-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-line);
    margin-bottom: 1.25rem;
  }

  .log-locator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .loc-line {
    flex: 1;
    border-top: 1px dashed var(--color-line);
    opacity: 0.3;
  }

  .loc-text {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--color-line);
    opacity: 0.55;
    white-space: nowrap;
  }

  .log-entry-line {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-top: 3px solid #1a1a1a;
    padding-top: 0.75rem;
  }

  .log-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .log-date {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--color-line);
  }

  /* ── Layout ──────────────────────────────────────────── */

  .log-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* ── Photo ───────────────────────────────────────────── */

  .photo-wrap {
    position: relative;
  }

  .photo-frame {
    width: 200px;
    height: 300px;
    overflow: hidden;
    border: 1px solid rgba(139, 115, 85, 0.35);
    position: relative;
  }

  /* Schematic corner marks */
  .photo-frame::before,
  .photo-frame::after {
    content: '';
    position: absolute;
    inset: 6px;
    pointer-events: none;
    z-index: 1;
  }

  .photo-frame::before {
    background:
      linear-gradient(to right,  var(--color-accent) 10px, transparent 10px) top    left  / 10px 1px no-repeat,
      linear-gradient(to bottom, var(--color-accent) 10px, transparent 10px) top    left  / 1px 10px no-repeat,
      linear-gradient(to left,   var(--color-accent) 10px, transparent 10px) bottom right / 10px 1px no-repeat,
      linear-gradient(to top,    var(--color-accent) 10px, transparent 10px) bottom right / 1px 10px no-repeat;
    opacity: 0.6;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 22% 0%;
    display: block;
    filter: grayscale(1);
  }

  /* ── Log body ─────────────────────────────────────────── */

  .log-body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.8;
    color: #2a2a2a;
    padding-top: 0.25rem;
  }

  .log-body p {
    margin: 0 0 1.25em;
  }

  .log-body p:last-child {
    margin-bottom: 0;
  }

  /* ── Mobile ──────────────────────────────────────────── */

  @media (max-width: 480px) {
    .log-layout {
      grid-template-columns: 1fr;
    }

    .photo-frame {
      width: 130px;
      height: 240px;
    }
  }
</style>
