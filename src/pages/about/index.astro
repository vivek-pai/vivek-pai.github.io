---
import SectionLayout from '@layouts/SectionLayout.astro';

const today = new Date();
const logDate = today.toISOString().split('T')[0].replace(/-/g, '.');
---

<SectionLayout
  title="About"
  description="Vivek Pai — HCI practitioner, maker, researcher, and aspiring Starfleet captain."
  sectionId="about"
>
  <div class="log">

    <!-- ── Header ─────────────────────────────────────── -->
    <header class="log-header">
      <div class="log-eyebrow">CAPTAIN'S QUARTERS · ABOUT</div>
      <div class="log-locator">
        <div class="loc-line"></div>
        <span class="loc-text">⬡ X: 078.9  Y: 108.6  [VP-01 // CAPTAIN'S QTR]</span>
        <div class="loc-line"></div>
      </div>
      <div class="log-entry-line">
        <span class="log-label">LOG ENTRY</span>
        <span class="log-date">{logDate}</span>
      </div>
    </header>

    <!-- ── Photo ──────────────────────────────────────── -->
    <div class="photo-wrap">
      <div class="photo-placeholder" aria-label="Photo placeholder">
        <span class="photo-label">// PHOTO</span>
      </div>
    </div>

    <!-- ── Log entries ────────────────────────────────── -->
    <div class="log-body">
      <p>
        Placeholder — first paragraph. A few sentences about who you are,
        written in first person. Keep it personal, not a resume summary.
      </p>
      <p>
        Placeholder — second paragraph. A bit more context: where you're from,
        what drives you, what you care about beyond the work.
      </p>
    </div>

  </div>
</SectionLayout>

<style>
  .log {
    max-width: 56ch;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 3rem 6rem;
  }

  /* ── Header ─────────────────────────────────────────── */

  .log-header {
    margin-bottom: 3rem;
  }

  .log-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-line);
    margin-bottom: 1.25rem;
  }

  .log-locator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .loc-line {
    flex: 1;
    border-top: 1px dashed var(--color-line);
    opacity: 0.3;
  }

  .loc-text {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--color-line);
    opacity: 0.55;
    white-space: nowrap;
  }

  .log-entry-line {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-top: 3px solid #1a1a1a;
    padding-top: 0.75rem;
  }

  .log-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .log-date {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--color-line);
  }

  /* ── Photo ───────────────────────────────────────────── */

  .photo-wrap {
    margin-bottom: 2.5rem;
  }

  .photo-placeholder {
    width: 180px;
    height: 180px;
    border: 1px dashed var(--color-line-faint);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
  }

  .photo-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--color-line-faint);
  }

  /* ── Log body ─────────────────────────────────────────── */

  .log-body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.8;
    color: #2a2a2a;
  }

  .log-body p {
    margin: 0 0 1.25em;
  }

  .log-body p:last-child {
    margin-bottom: 0;
  }
</style>
